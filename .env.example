NODE_ENV=development
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.example.com
SCOPES=read_customers,write_customers,read_orders,read_products,read_discounts,write_discounts,write_validations

# Runtime traffic goes through PgBouncer. Prisma CLI uses DIRECT_URL.
DATABASE_URL=postgresql://vip_pricing:change-me-runtime@127.0.0.1:6432/vip_pricing
DIRECT_URL=postgresql://vip_pricing_migrate:change-me-migrate@127.0.0.1:5432/vip_pricing
# Used only by the outbox dispatcher. Never expose this BYPASSRLS role to web.
MAINTENANCE_DATABASE_URL=postgresql://vip_pricing_worker:change-me-worker@127.0.0.1:5432/vip_pricing
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379
POSTGRES_ADMIN_PASSWORD=change-me-admin
VIP_RUNTIME_DB_PASSWORD=change-me-runtime
VIP_WORKER_DB_PASSWORD=change-me-worker
VIP_MIGRATION_DB_PASSWORD=change-me-migrate
REDIS_PASSWORD=change-me-redis

SHOPIFY_CUSTOMER_ACCOUNT_AUDIENCE=
REWARD_ENCRYPTION_KEY=
REWARD_CODE_SECRET=
OUTBOX_MAX_ATTEMPTS=8
WEBHOOK_PAYLOAD_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
LOG_LEVEL=info
